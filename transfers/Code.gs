/** مركز غيم — نظام تحويلات رسوم الطلاب
 * Deploy as Web App, execute as owner. Keep the spreadsheet and Drive folder private.
 */
const CFG = { USERS:"Users", TRANSFERS:"Transfers", AUDIT:"AuditLog", SETTINGS:"Settings", SESSION_SECONDS:21600, MAX_FILE_BYTES:8*1024*1024 };
function setup(){
  const ss=SpreadsheetApp.getActiveSpreadsheet();
  if(!ss) throw new Error("اربط المشروع بجدول Google Sheets أولًا.");
  ensureSheet_(ss,CFG.USERS,["userId","name","accessCode","role","active","createdAt"]);
  ensureSheet_(ss,CFG.TRANSFERS,["transferId","studentName","amount","period","notes","fileId","fileName","status","createdAt","createdBy","createdByName","reviewedAt","reviewedBy","reviewNotes","invoiceNumber","completedAt"]);
  ensureSheet_(ss,CFG.AUDIT,["at","userId","userName","action","transferId","details"]);
  const sh=ensureSheet_(ss,CFG.SETTINGS,["key","value"]);
  const folder=DriveApp.createFolder("مركز غيم - إيصالات تحويلات الطلاب (خاص)");
  setSetting_(sh,"RECEIPTS_FOLDER_ID",folder.getId());
  setSetting_(sh,"TIMEZONE","Asia/Riyadh");
  setSetting_(sh,"INITIALIZED","YES");
  SpreadsheetApp.getUi().alert("تم إعداد الأوراق ومجلد الإيصالات الخاص. أضف المستخدمين في ورقة Users قبل النشر.");
}
function ensureSheet_(ss,name,headers){let s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);if(s.getLastRow()===0)s.appendRow(headers);return s;}
function setSetting_(sh,key,value){const rows=sh.getDataRange().getValues();for(let i=1;i<rows.length;i++){if(rows[i][0]===key){sh.getRange(i+1,2).setValue(value);return;}}sh.appendRow([key,value]);}
function getSetting_(key){const sh=SpreadsheetApp.getActive().getSheetByName(CFG.SETTINGS);if(!sh)throw new Error("شغّل setup() أولًا");const rows=sh.getDataRange().getValues();for(let i=1;i<rows.length;i++)if(rows[i][0]===key)return String(rows[i][1]||"");return "";}
function doGet(){return json_({ok:true,service:"Ghaym Student Transfers API",message:"Use POST actions with a valid access code/session."});}
function doPost(e){try{const p=JSON.parse(e.postData.contents||"{}");const action=String(p.action||"");if(action==="login")return json_(login_(p));if(action==="logout")return json_(logout_(p));const user=auth_(p.token);if(action==="listTransfers")return json_(listTransfers_(user));if(action==="createTransfer")return json_(createTransfer_(user,p));if(action==="updateStatus")return json_(updateStatus_(user,p));if(action==="getReceipt")return json_(getReceipt_(user,p));if(action==="listAudit")return json_(listAudit_(user));return json_({ok:false,error:"إجراء غير معروف"});}catch(err){return json_({ok:false,error:safeMessage_(err)});}}
function login_(p){const code=String(p.accessCode||"").trim();if(code.length<4)throw new Error("رمز الدخول غير صحيح");const sh=SpreadsheetApp.getActive().getSheetByName(CFG.USERS);if(!sh)throw new Error("شغّل setup() وأضف المستخدمين أولًا");const rows=sh.getDataRange().getValues();const headers=rows.shift();const ix=Object.fromEntries(headers.map((h,i)=>[h,i]));const found=rows.find(r=>String(r[ix.accessCode]||"")===code&&String(r[ix.active]).toLowerCase()!=="false"&&String(r[ix.active])!=="0");if(!found)throw new Error("رمز الدخول غير صحيح أو الحساب غير مفعل");const role=String(found[ix.role]||"");if(!["ACCOUNTANT","DATA_ENTRY"].includes(role))throw new Error("صلاحية المستخدم غير صحيحة");const user={userId:String(found[ix.userId]),name:String(found[ix.name]),role};const token=Utilities.getUuid()+"."+Utilities.getUuid();CacheService.getScriptCache().put("session:"+token,JSON.stringify(user),CFG.SESSION_SECONDS);audit_(user,"LOGIN","","تسجيل دخول");return {ok:true,token,user};}
function logout_(p){if(p.token){const cache=CacheService.getScriptCache();const raw=cache.get("session:"+p.token);if(raw){audit_(JSON.parse(raw),"LOGOUT","","تسجيل خروج");cache.remove("session:"+p.token);}}return {ok:true};}
function auth_(token){if(!token)throw new Error("انتهت الجلسة، سجّل الدخول مجددًا");const raw=CacheService.getScriptCache().get("session:"+String(token));if(!raw)throw new Error("انتهت الجلسة، سجّل الدخول مجددًا");return JSON.parse(raw);}
function requireAccountant_(u){if(u.role!=="ACCOUNTANT")throw new Error("هذه العملية متاحة للمحاسب العام فقط");}
function createTransfer_(u,p){if(u.role!=="DATA_ENTRY")throw new Error("رفع التحويلات متاح لموظف إدخال البيانات فقط");const student=String(p.studentName||"").trim(),period=String(p.period||"").trim(),amount=Number(p.amount),notes=String(p.notes||"").trim();if(!student||!period||!Number.isFinite(amount)||amount<=0)throw new Error("أدخل اسم الطالب والفترة ومبلغًا صحيحًا");if(!p.fileBase64||String(p.mimeType)!=="application/pdf")throw new Error("إيصال PDF مطلوب");const bytes=Utilities.base64Decode(String(p.fileBase64));if(bytes.length>CFG.MAX_FILE_BYTES)throw new Error("حجم الملف يتجاوز 8 ميجابايت");if(bytes.length<5||bytes[0]!==37||bytes[1]!==80||bytes[2]!==68||bytes[3]!==70||bytes[4]!==45)throw new Error("الملف المرفوع ليس PDF صالحًا");const folder=DriveApp.getFolderById(getSetting_("RECEIPTS_FOLDER_ID"));const safeName=String(p.fileName||"receipt.pdf").replace(/[\\/:*?"<>|]/g,"_").slice(0,120);const blob=Utilities.newBlob(bytes,"application/pdf",safeName);const file=folder.createFile(blob);file.setSharing(DriveApp.Access.PRIVATE,DriveApp.Permission.NONE);const id="GH-"+Utilities.formatDate(new Date(),"Asia/Riyadh","yyyyMMdd-HHmmss")+"-"+Utilities.getUuid().slice(0,6).toUpperCase();const sh=SpreadsheetApp.getActive().getSheetByName(CFG.TRANSFERS);sh.appendRow([id,student,amount,period,notes,file.getId(),safeName,"PENDING",now_(),u.userId,u.name,"","","","",""]);audit_(u,"CREATE_TRANSFER",id,"رفع تحويل بقيمة "+amount);return {ok:true,transferId:id,status:"PENDING"};}
function listTransfers_(u){const sh=SpreadsheetApp.getActive().getSheetByName(CFG.TRANSFERS);const rows=sh.getDataRange().getValues();const headers=rows.shift();const ix=Object.fromEntries(headers.map((h,i)=>[h,i]));const transfers=rows.filter(r=>r[ix.transferId]&&(u.role==="ACCOUNTANT"||String(r[ix.createdBy])===u.userId)).map(r=>({transferId:String(r[ix.transferId]),studentName:String(r[ix.studentName]||""),amount:Number(r[ix.amount]||0),period:String(r[ix.period]||""),notes:String(r[ix.notes]||""),status:String(r[ix.status]||"PENDING"),createdAt:String(r[ix.createdAt]||""),createdByName:String(r[ix.createdByName]||""),reviewNotes:String(r[ix.reviewNotes]||""),invoiceNumber:String(r[ix.invoiceNumber]||"")})).reverse();return {ok:true,transfers};}
function updateStatus_(u,p){requireAccountant_(u);const id=String(p.transferId||"");const status=String(p.status||"");if(!["ACCEPTED","COMPLETED","RETURNED","REJECTED"].includes(status))throw new Error("الحالة المطلوبة غير مسموحة");const sh=SpreadsheetApp.getActive().getSheetByName(CFG.TRANSFERS),data=sh.getDataRange().getValues(),h=data[0],ix=Object.fromEntries(h.map((v,i)=>[v,i]));for(let n=1;n<data.length;n++){if(String(data[n][ix.transferId])!==id)continue;const current=String(data[n][ix.status]);if(status==="COMPLETED"&&!String(p.invoiceNumber||"").trim())throw new Error("رقم الفاتورة مطلوب قبل التأكيد");if(status==="COMPLETED"&&!["ACCEPTED","INVOICE_PENDING","COMPLETED"].includes(current))throw new Error("يجب تأكيد التحويل أولًا قبل تأكيد الفاتورة");const row=n+1;sh.getRange(row,ix.status+1).setValue(status);sh.getRange(row,ix.reviewedAt+1).setValue(now_());sh.getRange(row,ix.reviewedBy+1).setValue(u.name);sh.getRange(row,ix.reviewNotes+1).setValue(String(p.reviewNotes||""));if(p.invoiceNumber)sh.getRange(row,ix.invoiceNumber+1).setValue(String(p.invoiceNumber).trim());if(status==="COMPLETED")sh.getRange(row,ix.completedAt+1).setValue(now_());audit_(u,"UPDATE_STATUS",id,current+" → "+status+(p.invoiceNumber?"؛ رقم الفاتورة "+p.invoiceNumber:""));return {ok:true,status};}throw new Error("لم يتم العثور على التحويل");}
function getReceipt_(u,p){const id=String(p.transferId||"");const sh=SpreadsheetApp.getActive().getSheetByName(CFG.TRANSFERS),data=sh.getDataRange().getValues(),h=data[0],ix=Object.fromEntries(h.map((v,i)=>[v,i]));for(let n=1;n<data.length;n++){const r=data[n];if(String(r[ix.transferId])!==id)continue;if(u.role!=="ACCOUNTANT"&&String(r[ix.createdBy])!==u.userId)throw new Error("ليس لديك صلاحية لعرض هذا الإيصال");const file=DriveApp.getFileById(String(r[ix.fileId]));const bytes=file.getBlob().getBytes();return {ok:true,fileName:String(r[ix.fileName]||"receipt.pdf"),base64:Utilities.base64Encode(bytes)};}throw new Error("لم يتم العثور على الإيصال");}
function listAudit_(u){requireAccountant_(u);const sh=SpreadsheetApp.getActive().getSheetByName(CFG.AUDIT);const data=sh.getDataRange().getDisplayValues();const h=data.shift(),ix=Object.fromEntries(h.map((v,i)=>[v,i]));return {ok:true,events:data.slice(-500).reverse().map(r=>({at:r[ix.at],userId:r[ix.userId],userName:r[ix.userName],action:r[ix.action],transferId:r[ix.transferId],details:r[ix.details]}))};}
function audit_(u,action,id,details){const sh=SpreadsheetApp.getActive().getSheetByName(CFG.AUDIT);if(sh)sh.appendRow([now_(),u.userId,u.name,action,id,details]);}
function now_(){return Utilities.formatDate(new Date(),"Asia/Riyadh","yyyy-MM-dd HH:mm:ss");}
function safeMessage_(e){const m=String(e&&e.message||e||"حدث خطأ");return m.length>220?m.slice(0,220):m;}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
